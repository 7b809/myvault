# Copy to .env — never commit real secrets.

# MEGA credentials (required)
MEGA_EMAIL=you@example.com
MEGA_PASSWORD=your-mega-password

# Root folder inside MEGA Cloud Drive
MEGA_ROOT_FOLDER=MyVault

# HTTP
HOST=127.0.0.1
PORT=8000

# Local cache / metadata mirror (gitignored)
DATA_DIR=data

# Per-file upload ceiling in MB
MAX_UPLOAD_MB=1024

# When true, logs include emails, MEGA links and other account detail.
# Leave false in normal use — everything sensitive is redacted.
TEST_FLAG=false

# ============================================================
# Auth
# ============================================================

# --- MongoDB (Atlas / self-hosted) -------------------------
MONGO_URL=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=myvault

# --- Initial user (created on first boot if missing) -------
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-this-strong-password

# --- Sessions ----------------------------------------------
SESSION_HOURS=24
SESSION_COOKIE=vaultra_session

# --- Login throttling --------------------------------------
LOGIN_WINDOW_MINUTES=15
LOGIN_ALERT_AT=2
LOGIN_BLOCK_AFTER=5
LOGIN_BLOCK_MINUTES=30

# --- Telegram alerts (silent background messages) ----------
TELE_BOT_TOKEN=
TELE_BOT_CHATID=

# ============================================================
# Activity log (single-doc, date-keyed)
# ============================================================
ACTIVITY_RETENTION_DAYS=90
ACTIVITY_MAX_RECENT=50